# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Leave empty to run in demo mode (no auth gate, tools use browser storage).

NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — or the legacy anon key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — or legacy service_role. SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=

# Comma-separated emails that are always super admins (server only).
# They can promote other users from /admin/users. Requires SUPABASE_SECRET_KEY.
SUPER_ADMIN_EMAILS=

# Later: AI provider keys (server only)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
